# Copy to .env and fill with your own values. Never commit .env.
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/pazar_radar
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
API_RATE_LIMIT=180
AUTH_RATE_LIMIT=20
DB_TIMEOUT_MS=10000
LOG_LEVEL=info
# Optional Redis cache (leave empty to disable cache)
REDIS_URL=

# Optional Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
